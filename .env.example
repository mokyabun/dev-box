DEVBOX_IMAGE=ghcr.io/mokyabun/dev-box:latest
DEVBOX_HOST=code.kya.sh
OPENCODE_HOST=opencode.kya.sh
DEVBOX_SSH_PORT=2223

APP_DATA_ROOT=/data/compose/appdata
DEV_WORKSPACE_ROOT=/data/compose/workspace
PUID=1001
PGID=1001
TZ=Asia/Seoul

# Replace these before starting the container.
CODE_SERVER_PASSWORD=replace-with-a-long-random-password
OPENCODE_PASSWORD=replace-with-another-long-random-password

# One or more newline-separated OpenSSH public keys. For Compose .env files,
# keeping this empty and adding ~/.ssh/authorized_keys through code-server is
# usually simpler.
DEVBOX_SSH_AUTHORIZED_KEYS=
